# GateSense environment variables
# ---------------------------------------------------------------
# Copy this file to `.env` and change values as needed:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets. The values below
# are local-development defaults only and are safe to publish.
# New variables are added here in the phase that introduces them.
# ---------------------------------------------------------------

# --- General ---------------------------------------------------
# Name of the environment: development | test | production
APP_ENV=development

# --- PostgreSQL (database) ------------------------------------
POSTGRES_USER=gatesense
POSTGRES_PASSWORD=gatesense_dev_password
POSTGRES_DB=gatesense
# Port exposed on your machine (container always listens on 5432)
POSTGRES_PORT=5432

# --- Redis (cache, queue, pub/sub) ----------------------------
REDIS_PORT=6379

# --- Mailpit (fake SMTP server that catches all dev email) ----
# SMTP port the backend sends to; open the web UI to read the mail
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Object storage (S3-compatible, for plate snapshots) -------
# Local dev uses RustFS (see docs/adr/0002-dev-object-storage.md).
S3_ACCESS_KEY=gatesense
S3_SECRET_KEY=gatesense_dev_secret
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- Backend API ----------------------------------------------
BACKEND_PORT=8000
# Log level for the API's JSON logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Where the backend finds Postgres and Redis when it runs on your machine.
# (Inside Docker Compose these are overridden to use the service names.)
# 127.0.0.1, not "localhost": on Windows "localhost" is tried as IPv6 (::1) first, and
# the Docker ports listen on IPv4 only, so connections can stall.
# The "+psycopg" part picks the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://gatesense:gatesense_dev_password@127.0.0.1:5432/gatesense
REDIS_URL=redis://127.0.0.1:6379/0
# Tests create and use their own database. Default: DATABASE_URL + "_test".
# TEST_DATABASE_URL=postgresql+psycopg://gatesense:gatesense_dev_password@127.0.0.1:5432/gatesense_test

# --- Auth -----------------------------------------------------
# Secret used to sign login tokens (JWTs). The default below is for local dev only;
# the API refuses to start in production with it. Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me
# Access tokens are short-lived; refresh tokens get a new pair when they expire.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# --- Gate events ----------------------------------------------
# OCR reads below this confidence (0-1) go to the guard review queue.
PLATE_CONFIDENCE_THRESHOLD=0.80
# Fuzzy matching: a read this many characters away from a known plate still matches.
PLATE_FUZZY_MAX_DISTANCE=1
# Same plate on the same lane within this many seconds = one event (sliding window).
GATE_EVENT_COOLDOWN_SECONDS=30
# Capture times further than this in the future are rejected (camera clock wrong).
GATE_EVENT_MAX_CLOCK_SKEW_SECONDS=300

# --- Visit time limits (minutes; admin-configurable from Phase 4) ---
VISIT_LIMIT_GUEST_MINUTES=240
VISIT_LIMIT_DELIVERY_MINUTES=20
VISIT_LIMIT_CAB_MINUTES=10
VISIT_LIMIT_SERVICE_MINUTES=120

# --- Approvals ------------------------------------------------
# Default time residents get to approve a visitor before the guard decides (the admin
# can change it per society in Settings).
APPROVAL_TIMEOUT_SECONDS=180

# --- Email (the backend sends through this SMTP server) ------
# Development: Mailpit above catches everything (open http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM="GateSense <noreply@gatesense.local>"
# SMTP_USERNAME= / SMTP_PASSWORD=   (a real provider in production; never commit them)
# Where visitors' "time remaining" links point (the API's public address).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Overstay escalation and privacy ---------------------------
OVERSTAY_REMINDER_MINUTES=30
OVERSTAY_ESCALATION_MINUTES=60
RECONCILIATION_STALE_HOURS=24
# Visitor personal data is deleted after this many days (admins can change it per society).
VISITOR_RETENTION_DAYS=90

# --- Telegram bot (optional) -----------------------------------
# Leave empty to run without Telegram (web approvals still work). See docs/telegram.md.
# Put the real token in your .env / hosting dashboard only, never in git or a chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; sent by Telegram with every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# --- Plate snapshots ------------------------------------------
# "s3" = the S3-compatible storage container above (RustFS), "local" = a folder.
SNAPSHOT_STORAGE=s3
# Used when SNAPSHOT_STORAGE=local (default: <repo>/data/snapshots, git-ignored).
# SNAPSHOT_LOCAL_DIR=./data/snapshots
SNAPSHOT_MAX_BYTES=2000000
# Where the backend reaches S3 when it runs on your machine (Compose overrides it).
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=gatesense-snapshots
S3_REGION=us-east-1
# S3_ACCESS_KEY and S3_SECRET_KEY are set in the object storage section above.

# --- Demo data ------------------------------------------------
# Password of every account created by `uv run python -m app.seed`.
# Public on purpose: the demo login buttons use it.
DEMO_PASSWORD=GateSense@123

# --- Frontend -------------------------------------------------
FRONTEND_PORT=5173
# Where the browser reaches the backend
VITE_API_BASE_URL=http://localhost:8000
