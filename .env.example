# GateSense environment variables
# ---------------------------------------------------------------
# Copy this file to `.env` and change values as needed:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets. The values below
# are local-development defaults only and are safe to publish.
# New variables are added here in the phase that introduces them.
# ---------------------------------------------------------------

# --- General ---------------------------------------------------
# Name of the environment: development | test | production
APP_ENV=development

# --- PostgreSQL (database) ------------------------------------
POSTGRES_USER=gatesense
POSTGRES_PASSWORD=gatesense_dev_password
POSTGRES_DB=gatesense
# Port exposed on your machine (container always listens on 5432)
POSTGRES_PORT=5432

# --- Redis (cache, queue, pub/sub) ----------------------------
REDIS_PORT=6379

# --- Mailpit (fake SMTP server that catches all dev email) ----
# SMTP port the backend sends to; open the web UI to read the mail
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Object storage (S3-compatible, for plate snapshots) -------
# Local dev uses RustFS (see docs/adr/0002-dev-object-storage.md).
S3_ACCESS_KEY=gatesense
S3_SECRET_KEY=gatesense_dev_secret
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- Backend API ----------------------------------------------
BACKEND_PORT=8000

# --- Frontend -------------------------------------------------
FRONTEND_PORT=5173
# Where the browser reaches the backend
VITE_API_BASE_URL=http://localhost:8000
