# Production settings for docker-compose.prod.yml. Copy to .env.prod ON THE SERVER and fill
# in the REQUIRED values there. Never commit .env.prod (it is git-ignored).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Generate secrets on the server with:  openssl rand -hex 32

# --- REQUIRED ---------------------------------------------------------------------------
# Public hostname. Caddy gets a free HTTPS certificate for it (ports 80 and 443 must be
# open). No domain? Use your server's IP with sslip.io, e.g. 203-0-113-7.sslip.io
SITE_ADDRESS=
# The same address with https://, used in links inside emails.
PUBLIC_BASE_URL=
# Long random strings (openssl rand -hex 32). Changing JWT_SECRET_KEY signs everyone out.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# --- Images -----------------------------------------------------------------------------
# CI publishes images to GHCR on every merge to main, tagged "latest" and with the commit SHA.
IMAGE_PREFIX=ghcr.io/akinchan-jain-7/gatesense
IMAGE_TAG=latest

# --- Public demo ------------------------------------------------------------------------
# true = one-click demo logins, demo seed data, "Reset demo" button and a nightly reset.
# NEVER true for a real society: anyone could reset (delete) its data.
DEMO_MODE=false
DEMO_PASSWORD=GateSense@123
# "demo" also starts the traffic simulator (only makes sense with DEMO_MODE=true).
COMPOSE_PROFILES=
SIM_SPEED=1

# --- Optional ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# API worker processes (about 1 per CPU core).
WEB_CONCURRENCY=2
# If set, GET /metrics on the private network needs "Authorization: Bearer <token>".
METRICS_TOKEN=

# Visitor personal data is deleted after this many days.
VISITOR_RETENTION_DAYS=90

# Email. Empty = Mailpit catches every email (read it through an SSH tunnel, see
# docs/deployment.md). For real email, use your provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=
SMTP_FROM=

# Telegram bot (optional): create a bot with @BotFather, see docs/deployment.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Snapshots: "local" (a Docker volume on this server) or "s3" (any S3-compatible bucket).
SNAPSHOT_STORAGE=local
S3_ENDPOINT_URL=
S3_BUCKET=gatesense-snapshots
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
